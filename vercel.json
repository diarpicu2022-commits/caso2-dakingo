{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:css",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{views/**,public/**}"
    }
  },
  "rewrites": [{ "source": "/", "destination": "/api" }]
}
