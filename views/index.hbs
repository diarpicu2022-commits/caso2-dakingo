<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <meta name="description" content="Dakingo — FSSAI certified online bakery: cakes, desserts and hampers for every celebration.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@800&family=Dancing+Script:wght@700&family=Signika:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="preload" as="image" href="/img/mockup/hero-main.webp">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="min-h-screen">
<div class="mx-auto w-full xl:w-170 xl:pt-5.5 xl:pb-3.5">
<div class="overflow-hidden bg-blush xl:rounded-[0.75rem] xl:shadow-[0_0.25rem_1.5rem_rgb(120_60_30/0.08)]">

  <!-- ============ HEADER ============ -->
  <header>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 px-4 py-3 md:px-8 xl:h-11 xl:flex-nowrap xl:gap-0 xl:py-0 xl:pr-10.5 xl:pl-10">
      <a href="/" class="font-sans text-[1.75rem] leading-none font-bold tracking-[-0.01em] text-brand xl:text-[1.625rem]">Dakingo</a>

      <form role="search" class="order-last flex h-11 w-full items-center rounded-full border border-brand/70 bg-white/70 pl-3 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-brand md:order-none md:ml-auto md:w-72 xl:h-5.5 xl:w-42 xl:pl-2" onsubmit="return false">
        {{> icon-search cls="size-4 shrink-0 text-ink xl:size-[0.6875rem]"}}
        <label for="q" class="sr-only">Search cakes</label>
        <input id="q" type="search" placeholder="Search" class="min-w-0 flex-1 bg-transparent px-2 text-sm text-ink placeholder:text-ink-soft focus:outline-none xl:px-1.5 xl:text-[0.5625rem]">
        <button type="submit" aria-label="Search" class="grid size-11 shrink-0 place-items-center rounded-full bg-brand text-white transition-colors hover:bg-brand-700 xl:size-5.5">
          {{> icon-user cls="size-5 xl:size-[0.6875rem]"}}
        </button>
      </form>

      <div class="ml-auto flex items-center gap-2 md:ml-0 xl:ml-3 xl:gap-2">
        <a href="#" aria-label="Cart" class="grid size-11 place-items-center text-brand xl:size-auto">{{> icon-cart cls="size-6 xl:size-[0.9375rem]"}}</a>
        <a href="#" class="py-3 text-sm font-medium text-brand hover:underline xl:py-0 xl:text-[0.59375rem]">Login/Signup</a>
      </div>
    </div>

    <nav aria-label="Categories" class="border-t border-blush-line">
      <div class="no-scrollbar flex items-center gap-6 overflow-x-auto px-4 py-2 md:px-8 xl:h-10.25 xl:justify-between xl:gap-0 xl:overflow-visible xl:py-0 xl:pr-10.25 xl:pl-10.25">
        {{#each nav}}
        <a href="#" class="shrink-0 py-2.5 text-[0.9375rem] font-medium whitespace-nowrap text-brand transition-colors hover:text-brand-800 xl:py-0 xl:text-[0.6875rem]">{{this}}</a>
        {{/each}}
        <a href="#" class="shrink-0 rounded-full bg-brand-700 px-5 py-3 text-sm font-bold whitespace-nowrap text-white uppercase transition-colors hover:bg-brand-800 xl:flex xl:h-5.75 xl:w-20.5 xl:items-center xl:justify-center xl:p-0 xl:text-[0.65625rem]">Order now</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- ============ HERO ============ -->
    <section aria-labelledby="hero-title" class="hero-bg relative overflow-hidden pb-24 xl:h-76.25 xl:pb-0">
      <!-- burbujas decorativas medidas sobre el mockup -->
      <span aria-hidden="true" class="absolute top-[-1.5rem] left-[58%] size-24 rounded-full bg-white/10 xl:top-[-1.875rem] xl:left-58 xl:size-[4.875rem]"></span>
      <span aria-hidden="true" class="absolute top-6 right-6 hidden size-5 rounded-full bg-white/12 xl:top-5.5 xl:right-14.5 xl:block xl:size-[1.25rem]"></span>
      <span aria-hidden="true" class="absolute right-[-2rem] bottom-[-3rem] size-40 rounded-full bg-white/10 xl:right-[-2.75rem] xl:bottom-[-2.5rem] xl:size-[8.25rem]"></span>
      <span aria-hidden="true" class="absolute right-24 bottom-[-4rem] hidden size-32 rounded-full bg-white/8 xl:right-[4.875rem] xl:bottom-[-3.5rem] xl:block xl:size-[8.75rem]"></span>
      <span aria-hidden="true" class="absolute bottom-24 left-5 size-6 rounded-full bg-white/12 xl:bottom-[6.75rem] xl:left-5.5 xl:size-[1.75rem]"></span>

      <div class="relative flex flex-col items-center gap-8 px-4 pt-8 md:flex-row md:items-start md:px-8 xl:block xl:p-0">
        <!-- plato principal -->
        <div class="size-64 shrink-0 overflow-hidden rounded-full border-[6px] border-white shadow-photo md:size-56 xl:absolute xl:top-4 xl:left-11 xl:size-50 xl:border-[0.375rem]">
          <img src="/img/mockup/hero-main.webp" alt="Chocolate drip cake topped with strawberries and blueberries" class="size-full object-cover" width="744" height="744">
        </div>

        <!-- titular -->
        <div class="relative text-center text-white md:text-left xl:absolute xl:top-[2.875rem] xl:left-[16.8125rem]">
          <h1 id="hero-title" class="font-display text-[2.5rem] leading-[0.95] uppercase xl:text-[2rem] xl:leading-[1.875rem]">Decadent<br>Chocolate<br>Bliss!</h1>
          <svg aria-hidden="true" viewBox="0 0 120 26" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" class="absolute top-[5.4rem] left-[7.5rem] hidden w-30 text-white/55 xl:top-[3.875rem] xl:left-[7.125rem] xl:block xl:w-[7.875rem]">
            <path d="M2 18c8-2 14-8 20-6s4 6 10 5 6-6 12-5 4 5 10 4 6-4 11-3 5 3 9 2c6-1 9-8 12-12s7-3 6 2-6 9-3 10 8-4 11-6 6 0 7 3-2 6-6 5"/>
          </svg>
          <p class="mt-3 text-xl leading-tight font-normal text-white/95 xl:mt-0 xl:text-[1.1875rem]">Satisfy Your Sweet Cravings</p>

          <a href="#bestsellers" class="relative mt-7 inline-flex items-center rounded-full bg-[#922129] px-6 pt-3.5 pb-2 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.06)] transition-colors hover:bg-brand-800 xl:mt-[1.0625rem] xl:-ml-0.75 xl:h-8 xl:w-29.25 xl:px-0 xl:pt-0 xl:pb-0">
            <span class="absolute top-0 left-4 -translate-y-1/3 font-script text-sm leading-none text-white xl:left-[0.8125rem] xl:text-[0.5625rem]">Special Offer!</span>
            <span class="font-display text-2xl leading-none text-white xl:pt-[0.3125rem] xl:pl-4 xl:text-[1.0625rem]">SAVE 20%</span>
          </a>
        </div>

        <!-- platos secundarios -->
        <div class="flex gap-5 md:ml-auto md:flex-col xl:contents">
          <div class="size-28 overflow-hidden rounded-full border-4 border-white shadow-photo xl:absolute xl:top-5.5 xl:left-128.75 xl:size-22.5 xl:border-[0.25rem]">
            <img src="/img/mockup/hero-top.webp" alt="Molten chocolate lava cake" class="size-full object-cover" width="328" height="328" loading="lazy">
          </div>
          <div class="size-28 overflow-hidden rounded-full border-4 border-white shadow-photo xl:absolute xl:top-32 xl:left-128.75 xl:size-22.5 xl:border-[0.25rem]">
            <img src="/img/mockup/hero-bottom.webp" alt="Slice of layered chocolate cake" class="size-full object-cover" width="328" height="328" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CUERPO ============ -->
    <div class="relative -mt-12 rounded-t-[1.5rem] bg-paper px-4 pt-8 md:mx-4 md:px-6 xl:mx-4 xl:-mt-18 xl:px-6 xl:pt-7">

      <!-- Menu -->
      <section aria-labelledby="menu-title" class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between xl:gap-0 xl:pr-[2.875rem]">
        <div class="xl:pt-0.5">
          <h2 id="menu-title" class="text-[2rem] leading-none font-bold text-brand xl:text-[1.625rem]">Menu</h2>
          <p class="mt-2 text-base font-medium text-brand-700 xl:mt-1 xl:text-[0.6875rem]">What will you wish for?</p>
          <ul class="mt-4 flex gap-3 xl:mt-[0.375rem] xl:gap-[0.3125rem]" aria-label="Quick picks">
            {{#each quickPicks}}
            <li><a href="#" aria-label="{{label}}" class="block size-11 overflow-hidden rounded-full transition-transform duration-200 hover:scale-105 xl:size-8"><img src="{{image}}" alt="" class="size-full" width="128" height="128"></a></li>
            {{/each}}
          </ul>
        </div>

        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4 xl:grid-cols-[repeat(4,5rem)] xl:gap-3" aria-label="Menu categories">
          {{#each categories}}
          <li>
            <a href="#" class="flex h-28 flex-col items-center justify-center gap-2 rounded-[0.875rem] bg-white text-brand shadow-tile transition-transform duration-200 hover:-translate-y-0.5 xl:h-19 xl:gap-[0.125rem] xl:rounded-[0.75rem] xl:pt-0.5">
              <img src="{{image}}" alt="" class="h-10 w-11 xl:h-9 xl:w-10" width="160" height="144">
              <span class="text-xs font-semibold tracking-[0.02em] uppercase xl:text-[0.5625rem]">{{label}}</span>
            </a>
          </li>
          {{/each}}
        </ul>
      </section>

      <!-- Bestsellers -->
      <section id="bestsellers" aria-labelledby="best-title" class="mt-10 xl:mt-[1.0625rem]">
        <h2 id="best-title" class="text-xl font-semibold text-brand xl:text-[1.0625rem] xl:leading-[1.375rem]">Bestsellers from Across the Country</h2>

        <ul class="mt-5 grid grid-cols-2 gap-3 md:gap-4 lg:grid-cols-4 xl:mt-[1.4375rem] xl:ml-px xl:grid-cols-[repeat(4,8.6875rem)] xl:gap-[0.90625rem]">
          {{#each products}}
          <li class="relative flex flex-col rounded-[0.875rem] bg-white p-2 shadow-tile xl:h-[8.625rem] xl:rounded-[0.75rem] xl:p-[0.3125rem]">
            <div class="relative aspect-[125/73] overflow-hidden bg-white xl:aspect-auto xl:h-[4.5rem]">
              <img src="{{image}}" alt="{{name}}" class="size-full object-cover" width="500" height="292" loading="lazy">
            </div>
            <div class="flex flex-1 flex-col px-1.5 pt-2 pr-12 xl:px-[0.3125rem] xl:pt-[0.1875rem]">
              <span class="text-brand xl:absolute xl:top-[3.75rem] xl:left-[0.8125rem]">{{> icon-heart cls="size-5 xl:size-[0.75rem]"}}</span>
              <h3 class="mt-1 text-[0.9375rem] leading-snug font-semibold text-brand xl:mt-0 xl:text-[0.71875rem] xl:leading-[0.8125rem]">{{name}}</h3>
              <p class="mt-2 flex items-center gap-1.5 xl:mt-[0.4375rem] xl:gap-[0.1875rem]">
                <span class="text-sm font-bold text-[#7a3a2e] xl:text-[0.59375rem]">&#8377;{{price}}</span>
                <span class="text-xs text-ink-soft xl:text-[0.40625rem]">{{tag}}</span>
              </p>
              <p class="mt-1 flex items-center gap-1 text-xs text-ink-soft xl:mt-[0.0625rem] xl:gap-[0.1875rem] xl:text-[0.40625rem]">
                <span class="flex" aria-label="{{rating}} out of 5 stars">
                  {{#each stars}}<span class="{{#if this}}text-gold{{else}}text-field{{/if}}">{{> icon-star cls="size-3.5 xl:size-[0.4375rem]"}}</span>{{/each}}
                </span>
                {{reviews}}
              </p>
            </div>
            <button type="button" aria-label="Add {{name}} to cart" class="absolute right-2 bottom-2 grid size-11 place-items-center rounded-full bg-brand text-white transition-colors hover:bg-brand-800 xl:right-[0.4375rem] xl:bottom-[0.625rem] xl:size-[0.8125rem]">
              {{> icon-bag cls="size-5 xl:size-[0.5rem]"}}
            </button>
          </li>
          {{/each}}
        </ul>

        <div class="mt-5 flex justify-end xl:mt-[0.8125rem]">
          <a href="#" class="inline-flex h-11 items-center rounded-full bg-brand px-6 text-sm font-bold text-white uppercase transition-colors hover:bg-brand-800 xl:h-5.75 xl:w-[4.6875rem] xl:justify-center xl:px-0 xl:text-[0.65625rem]">View all</a>
        </div>
      </section>

      <!-- Our Promise -->
      <section aria-labelledby="promise-title" class="mt-8 xl:mt-[0.3125rem]">
        <h2 id="promise-title" class="text-[2rem] leading-none font-bold text-brand xl:text-[1.625rem] xl:leading-[1.75rem]">Our Promise</h2>
        <p class="mt-2 text-base text-brand-700 xl:mt-[0.3125rem] xl:text-[0.71875rem]">There's no secret spell &ndash; only honest hard work!</p>

        <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_1.1fr] xl:mt-[1.5rem] xl:grid-cols-[16.8125rem_18.6875rem] xl:justify-between xl:gap-0">
          <div class="flex flex-col gap-5 xl:gap-0">
            <!-- glimpse -->
            <div class="rounded-[0.875rem] bg-rose-50 px-3 pt-5 pb-5 xl:h-[8.3125rem] xl:rounded-[0.75rem] xl:px-2 xl:pt-[1.0625rem] xl:pb-0">
              <p class="text-center text-base font-medium text-brand xl:text-[0.71875rem]">A glimpse into our secret spell &ndash; only magical work!</p>
              <ul class="mt-4 grid grid-cols-4 xl:mt-[0.625rem]">
                {{#each promises}}
                <li class="flex flex-col items-center text-center">
                  <img src="{{image}}" alt="" class="size-14 xl:size-[2.875rem]" width="184" height="184">
                  <span class="mt-2 text-xs leading-tight font-semibold text-brand-700 uppercase xl:mt-[0.375rem] xl:text-[0.53125rem] xl:leading-[0.6875rem]">{{label.[0]}}<br>{{label.[1]}}</span>
                </li>
                {{/each}}
              </ul>
            </div>

            <!-- magical ticket -->
            <div class="relative flex items-center gap-4 rounded-[0.875rem] bg-rose-50 p-4 xl:mt-[1.3125rem] xl:block xl:h-[9rem] xl:rounded-[0.75rem] xl:p-0">
              <img src="/img/mockup/ticket.webp" alt="" class="w-24 shrink-0 xl:absolute xl:top-[0.4375rem] xl:left-2 xl:w-[5.625rem]" width="360" height="456">
              <div class="xl:absolute xl:top-[1.875rem] xl:left-[6.4375rem]">
                <h3 class="text-xl font-bold tracking-[-0.01em] text-brand uppercase xl:text-[0.96875rem] xl:leading-[1.125rem]">The Magical Ticket</h3>
                <p class="mt-2 text-sm leading-snug text-ink xl:mt-[0.875rem] xl:text-[0.625rem] xl:leading-[0.875rem]">Add 3 reminders in your account.<br>Win offers worth Rs. 750</p>
                <a href="#" class="mt-3 inline-flex h-11 items-center rounded-full bg-brand px-5 text-sm font-bold text-white uppercase transition-colors hover:bg-brand-800 xl:mt-[0.5625rem] xl:ml-[3.5625rem] xl:h-6 xl:w-[5.375rem] xl:justify-center xl:px-0 xl:text-[0.65625rem]">Unlock now</a>
              </div>
            </div>

            <!-- social -->
            <div class="flex items-center gap-4 rounded-[0.875rem] bg-rose-50 px-3 py-3 xl:mt-[0.9375rem] xl:h-12 xl:gap-0 xl:rounded-[0.75rem] xl:px-[0.5625rem] xl:py-0">
              <ul class="flex gap-1 xl:gap-[0.25rem]" aria-label="Our community">
                {{#each avatars}}
                <li><img src="{{this}}" alt="" class="size-9 rounded-full object-cover xl:size-[1.4375rem]" width="92" height="92" loading="lazy"></li>
                {{/each}}
              </ul>
              <a href="#" class="text-base font-medium text-brand hover:underline xl:ml-[1.25rem] xl:text-[0.6875rem]">Follow us on social!</a>
            </div>
          </div>

          <!-- galería -->
          <ul class="grid grid-cols-2 gap-3 xl:mt-2 xl:grid-cols-[9.0625rem_9.0625rem] xl:grid-rows-[6.9375rem_7.0625rem_7.125rem] xl:gap-[0.5625rem]" aria-label="Celebrations baked by Dakingo">
            {{#each gallery}}
            <li class="relative aspect-[4/3] overflow-hidden rounded-[0.75rem] shadow-photo xl:aspect-auto xl:rounded-[0.625rem]">
              <img src="{{image}}" alt="{{caption}}" class="size-full object-cover" width="552" height="428" loading="lazy">
            </li>
            {{/each}}
          </ul>
        </div>
      </section>

      <!-- Banner -->
      <p class="mt-10 rounded-[1rem] bg-brand px-5 py-5 text-center text-lg leading-snug font-semibold tracking-[-0.01em] text-white xl:mt-[1.8125rem] xl:flex xl:h-[3.375rem] xl:items-center xl:justify-center xl:rounded-[0.875rem] xl:p-0 xl:text-[1.0625rem] xl:whitespace-nowrap">
        Dakingo &ndash; Your Trusted FSSAI Certified Online Bakery for Every Celebration
      </p>

      <!-- ============ FOOTER ============ -->
      <footer class="mt-8 pb-8 xl:mt-[1.1875rem] xl:grid xl:grid-cols-[11rem_5.25rem_5.875rem_5.6875rem_1fr] xl:grid-rows-[auto_auto] xl:pb-[0.875rem]">
        <div class="xl:row-span-2">
          <p class="text-[1.75rem] leading-none font-bold text-brand xl:text-[1.5625rem]">Dakingo</p>
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-soft xl:mt-[0.5rem] xl:block xl:text-[0.46875rem] xl:leading-[0.71875rem]">
            {{#each footer.brandLinks}}<li><a href="#" class="hover:text-brand">{{this}}</a></li>{{/each}}
          </ul>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-4 xl:col-span-4 xl:mt-[0.5rem] xl:grid-cols-[5.25rem_5.875rem_5.6875rem_1fr] xl:gap-0">
          {{#each footer.columns}}
          <div>
            <p class="text-xs font-bold text-brand uppercase xl:text-[0.46875rem]">{{title}}</p>
            <ul class="mt-2 space-y-1 text-sm text-ink-soft xl:mt-[0.25rem] xl:space-y-0 xl:text-[0.46875rem] xl:leading-[0.6875rem]">
              {{#each links}}<li><a href="#" class="hover:text-brand">{{this}}</a></li>{{/each}}
            </ul>
          </div>
          {{/each}}
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3 xl:col-span-3 xl:col-start-3 xl:mt-[1rem] xl:flex-nowrap xl:gap-[0.3125rem]">
          <form class="flex w-full gap-2 sm:w-auto xl:contents" onsubmit="return false">
            <label for="email" class="sr-only">Email address</label>
            <input id="email" type="email" placeholder="Enter Email Address" class="h-11 min-w-0 flex-1 rounded-full border border-field bg-white px-4 text-sm text-ink placeholder:text-ink-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:w-72 sm:flex-none xl:h-[1.5625rem] xl:w-[11rem] xl:px-[0.6875rem] xl:text-[0.59375rem]">
            <button type="submit" class="h-11 shrink-0 rounded-full bg-brand px-5 text-sm font-bold text-white uppercase transition-colors hover:bg-brand-800 xl:h-[1.5625rem] xl:w-[5.0625rem] xl:px-0 xl:text-[0.625rem]">Subscribe</button>
          </form>
          <a href="#" class="ml-auto flex items-center gap-2 text-sm font-bold whitespace-nowrap text-brand xl:-mt-[1.5rem] xl:flex-col xl:gap-[0.3125rem] xl:text-[0.4375rem]">
            {{> icon-help cls="size-6 xl:size-[1.25rem]"}}
            Hey, need any help?
          </a>
        </div>
      </footer>
    </div>
  </main>
</div>
</div>
</body>
</html>
