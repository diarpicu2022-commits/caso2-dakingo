{
  "name": "caso2-dakingo",
  "version": "1.0.0",
  "private": true,
  "description": "Caso 2 \u00e2\u20ac\u201d Dakingo: landing pixel perfect con NestJS + Tailwind CSS",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --watch",
    "build": "npm run build:css && nest build",
    "start": "npm run build:css && nest start",
    "start:dev": "npm run build:css && nest start --watch",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "hbs": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@tailwindcss/cli": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/hbs": "^4.0.5",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}